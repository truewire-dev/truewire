{
  "docs": "https://docs.github.com/en/rest/repos/repos#get-a-repository",
  "meta": {
    "public": true
  },
  "spec": {
    "kind": "rpc",
    "transports": [
      "http"
    ],
    "path": "/repos/{owner}/{repo}",
    "method": "GET",
    "description": "Get a repository. Metadata, counts and the license as GitHub reports them.",
    "request": {
      "title": "GetRepositoryRequest",
      "type": "object",
      "description": "Which repository.",
      "properties": {
        "owner": {
          "type": "string",
          "description": "Account owner of the repository, case-insensitive."
        },
        "repo": {
          "type": "string",
          "description": "Repository name without the `.git` extension, case-insensitive."
        }
      },
      "required": [
        "owner",
        "repo"
      ]
    },
    "response": {
      "title": "Repository",
      "type": "object",
      "description": "A repository.",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Repository id."
        },
        "node_id": {
          "type": "string",
          "description": "GraphQL node id."
        },
        "name": {
          "type": "string",
          "description": "Repository name."
        },
        "full_name": {
          "type": "string",
          "description": "`owner/name`."
        },
        "private": {
          "type": "boolean",
          "description": "Whether the repository is private."
        },
        "owner": {
          "$ref": "SimpleUser",
          "description": "Owning account."
        },
        "html_url": {
          "type": "string",
          "description": "Web page of the repository."
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "description": "Short description, when set."
            },
            {
              "type": "null"
            }
          ],
          "description": "Short description, when set."
        },
        "fork": {
          "type": "boolean",
          "description": "Whether the repository is a fork."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the repository was created."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "When repository metadata last changed."
        },
        "pushed_at": {
          "type": "string",
          "format": "date-time",
          "description": "When a branch was last pushed."
        },
        "homepage": {
          "anyOf": [
            {
              "type": "string",
              "description": "Homepage URL, when set."
            },
            {
              "type": "null"
            }
          ],
          "description": "Homepage URL, when set."
        },
        "size": {
          "type": "integer",
          "description": "Size in kilobytes."
        },
        "stargazers_count": {
          "type": "integer",
          "description": "Number of stars."
        },
        "watchers_count": {
          "type": "integer",
          "description": "Number of watchers."
        },
        "language": {
          "anyOf": [
            {
              "type": "string",
              "description": "Primary language, when detected."
            },
            {
              "type": "null"
            }
          ],
          "description": "Primary language, when detected."
        },
        "forks_count": {
          "type": "integer",
          "description": "Number of forks."
        },
        "open_issues_count": {
          "type": "integer",
          "description": "Open issues and pull requests."
        },
        "archived": {
          "type": "boolean",
          "description": "Whether the repository is archived."
        },
        "disabled": {
          "type": "boolean",
          "description": "Whether the repository is disabled."
        },
        "license": {
          "anyOf": [
            {
              "$ref": "License",
              "description": "License, when detected."
            },
            {
              "type": "null"
            }
          ],
          "description": "License, when detected."
        },
        "topics": {
          "title": "Topics",
          "type": "array",
          "description": "Repository topics.",
          "items": {
            "type": "string",
            "description": "One topic."
          }
        },
        "visibility": {
          "type": "string",
          "description": "Visibility.",
          "enum": [
            "public",
            "private",
            "internal"
          ]
        },
        "default_branch": {
          "type": "string",
          "description": "Default branch name."
        }
      },
      "required": [
        "id",
        "name",
        "full_name",
        "private",
        "owner",
        "html_url",
        "created_at",
        "updated_at",
        "default_branch"
      ]
    }
  },
  "notes": [
    "The response schema names the fields a caller reads; GitHub sends about a hundred, and the rest pass through unchecked. Add a field here when you need it typed.",
    "Recorded with an authenticated token, so the live payload carried `temp_clone_token`; the capture script replaces it with `REDACTED_TEMP_CLONE_TOKEN` (authoring rule 6)."
  ]
}
