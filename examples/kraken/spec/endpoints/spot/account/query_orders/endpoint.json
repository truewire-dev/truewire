{
  "docs": "https://docs.kraken.com/api-reference/account-data/query-orders-info",
  "meta": {
    "signed": true
  },
  "redacted": [
    "nonce"
  ],
  "spec": {
    "kind": "rpc",
    "transports": [
      "http"
    ],
    "path": "/0/private/QueryOrders",
    "method": "POST",
    "description": "Retrieve information about specific orders, by transaction ID.\n\n**API Key Permissions Required:** `Orders and trades - Query open orders & trades` or `Orders and trades - Query closed orders & trades`, depending on the status of the order.",
    "request": {
      "title": "QueryOrdersRequest",
      "type": "object",
      "required": [
        "txid"
      ],
      "properties": {
        "txid": {
          "description": "The Kraken order identifier. To query multiple orders, use a comma-delimited list of up to 50 ids.",
          "type": "string"
        },
        "trades": {
          "description": "Whether or not to include trades related to position in output.",
          "type": "boolean",
          "default": false
        },
        "userref": {
          "description": "Restrict results to the given user reference id.",
          "type": "integer",
          "format": "int32"
        },
        "consolidate_taker": {
          "description": "Whether or not to consolidate trades by individual taker trades.",
          "type": "boolean",
          "default": true
        },
        "rebase_multiplier": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "rebased",
                "base"
              ],
              "default": "rebased"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional parameter for viewing xstocks data. `rebased` displays in terms of underlying equity, `base` displays in terms of SPV tokens."
        }
      }
    },
    "response": {
      "title": "QueriedOrdersFrame",
      "type": "object",
      "description": "Wire frame; the generated method returns `result`.",
      "required": [
        "error",
        "result"
      ],
      "properties": {
        "error": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Wire envelope field; see the core."
        },
        "result": {
          "title": "QueriedOrders",
          "description": "The queried orders, keyed by transaction ID. Each is either still open or already closed.",
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "title": "OpenOrder",
                "description": "One open order.",
                "type": "object",
                "properties": {
                  "refid": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Referral order transaction ID that created this order."
                  },
                  "userref": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Optional numeric client identifier associated with one or more orders."
                  },
                  "cl_ord_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Optional alphanumeric client identifier associated with the order."
                  },
                  "status": {
                    "description": "Status of the order: `pending` (pending book entry), `open`, `closed`, `canceled`, or `expired`.",
                    "type": "string",
                    "enum": [
                      "pending",
                      "open",
                      "closed",
                      "canceled",
                      "expired"
                    ]
                  },
                  "opentm": {
                    "description": "Unix timestamp of when the order was placed.",
                    "type": "number"
                  },
                  "starttm": {
                    "description": "Unix timestamp of order start time (or 0 if not set).",
                    "type": "number"
                  },
                  "expiretm": {
                    "description": "Unix timestamp of order end time (or 0 if not set).",
                    "type": "number"
                  },
                  "descr": {
                    "title": "OrderDescription",
                    "description": "Order description info.",
                    "type": "object",
                    "properties": {
                      "pair": {
                        "description": "Asset pair.",
                        "type": "string"
                      },
                      "type": {
                        "description": "Type of order.",
                        "type": "string",
                        "enum": [
                          "buy",
                          "sell"
                        ]
                      },
                      "ordertype": {
                        "description": "The execution model of the order.",
                        "type": "string",
                        "enum": [
                          "market",
                          "limit",
                          "iceberg",
                          "stop-loss",
                          "take-profit",
                          "stop-loss-limit",
                          "take-profit-limit",
                          "trailing-stop",
                          "trailing-stop-limit",
                          "settle-position"
                        ]
                      },
                      "price": {
                        "description": "Primary price.",
                        "type": "string"
                      },
                      "price2": {
                        "description": "Secondary price.",
                        "type": "string"
                      },
                      "leverage": {
                        "description": "Amount of leverage.",
                        "type": "string"
                      },
                      "order": {
                        "description": "Order description, as human-readable text.",
                        "type": "string"
                      },
                      "close": {
                        "description": "Conditional close order description (if conditional close set).",
                        "type": "string"
                      },
                      "aclass": {
                        "description": "Asset class of the pair.",
                        "type": "string"
                      }
                    }
                  },
                  "time_in_force": {
                    "description": "Time-in-force of the order: `gtc` (good till cancelled), `ioc` (immediate or cancel), `gtd` (good till date), or `fok` (fill or kill).",
                    "type": "string",
                    "enum": [
                      "gtc",
                      "ioc",
                      "gtd",
                      "fok"
                    ]
                  },
                  "vol": {
                    "description": "Volume of order (base currency).",
                    "type": "string"
                  },
                  "vol_exec": {
                    "description": "Volume executed (base currency).",
                    "type": "string"
                  },
                  "cost": {
                    "description": "Total cost (quote currency).",
                    "type": "string"
                  },
                  "fee": {
                    "description": "Total fee (quote currency).",
                    "type": "string"
                  },
                  "price": {
                    "description": "Average price (quote currency).",
                    "type": "string"
                  },
                  "stopprice": {
                    "description": "Stop price (quote currency).",
                    "type": "string"
                  },
                  "limitprice": {
                    "description": "Triggered limit price (quote currency, when limit-based order type triggered).",
                    "type": "string"
                  },
                  "trigger": {
                    "description": "Price signal used to trigger `stop-loss`/`take-profit`/`stop-loss-limit`/`take-profit-limit` orders. `last` is the implied trigger if this field is not set.",
                    "type": "string",
                    "enum": [
                      "last",
                      "index"
                    ],
                    "default": "last"
                  },
                  "margin": {
                    "description": "Indicates if the order is funded on margin.",
                    "type": "boolean"
                  },
                  "misc": {
                    "description": "Comma-delimited list of miscellaneous info: `stopped`, `touched`, `liquidated`, `partial`, `amended`.",
                    "type": "string"
                  },
                  "sender_sub_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "For institutional accounts, identifies the underlying sub-account/trader for Self Trade Prevention (STP)."
                  },
                  "oflags": {
                    "description": "Comma-delimited list of order flags: `post`, `fcib`, `fciq`, `nompp` (deprecated), `viqc`.",
                    "type": "string",
                    "example": "post"
                  },
                  "trades": {
                    "description": "List of trade IDs related to the order (if trades info requested and data available).",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "title": "ClosedOrder",
                "description": "One closed order.",
                "type": "object",
                "properties": {
                  "refid": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Referral order transaction ID that created this order."
                  },
                  "userref": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Optional numeric client identifier associated with one or more orders."
                  },
                  "cl_ord_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Optional alphanumeric client identifier associated with the order."
                  },
                  "status": {
                    "description": "Status of the order: `pending` (pending book entry), `open`, `closed`, `canceled`, or `expired`.",
                    "type": "string",
                    "enum": [
                      "pending",
                      "open",
                      "closed",
                      "canceled",
                      "expired"
                    ]
                  },
                  "opentm": {
                    "description": "Unix timestamp of when the order was placed.",
                    "type": "number"
                  },
                  "starttm": {
                    "description": "Unix timestamp of order start time (or 0 if not set).",
                    "type": "number"
                  },
                  "expiretm": {
                    "description": "Unix timestamp of order end time (or 0 if not set).",
                    "type": "number"
                  },
                  "descr": {
                    "title": "OrderDescription",
                    "description": "Order description info.",
                    "type": "object",
                    "properties": {
                      "pair": {
                        "description": "Asset pair.",
                        "type": "string"
                      },
                      "type": {
                        "description": "Type of order.",
                        "type": "string",
                        "enum": [
                          "buy",
                          "sell"
                        ]
                      },
                      "ordertype": {
                        "description": "Order type.",
                        "type": "string",
                        "enum": [
                          "market",
                          "limit",
                          "iceberg",
                          "stop-loss",
                          "take-profit",
                          "trailing-stop",
                          "stop-loss-limit",
                          "take-profit-limit",
                          "trailing-stop-limit",
                          "settle-position"
                        ]
                      },
                      "price": {
                        "description": "Primary price.",
                        "type": "string"
                      },
                      "price2": {
                        "description": "Secondary price.",
                        "type": "string"
                      },
                      "leverage": {
                        "description": "Amount of leverage.",
                        "type": "string"
                      },
                      "order": {
                        "description": "Order description, as human-readable text.",
                        "type": "string"
                      },
                      "close": {
                        "description": "Conditional close order description (if conditional close set).",
                        "type": "string"
                      },
                      "aclass": {
                        "description": "Asset class of the pair.",
                        "type": "string"
                      }
                    }
                  },
                  "time_in_force": {
                    "description": "Time-in-force of the order: `gtc` (good till cancelled), `ioc` (immediate or cancel), `gtd` (good till date), or `fok` (fill or kill).",
                    "type": "string",
                    "enum": [
                      "gtc",
                      "ioc",
                      "gtd",
                      "fok"
                    ]
                  },
                  "vol": {
                    "description": "Volume of order (base currency).",
                    "type": "string"
                  },
                  "vol_exec": {
                    "description": "Volume executed (base currency).",
                    "type": "string"
                  },
                  "cost": {
                    "description": "Total cost (quote currency).",
                    "type": "string"
                  },
                  "fee": {
                    "description": "Total fee (quote currency).",
                    "type": "string"
                  },
                  "price": {
                    "description": "Average price (quote currency).",
                    "type": "string"
                  },
                  "stopprice": {
                    "description": "Stop price (quote currency).",
                    "type": "string"
                  },
                  "limitprice": {
                    "description": "Triggered limit price (quote currency, when limit-based order type triggered).",
                    "type": "string"
                  },
                  "trigger": {
                    "description": "Price signal used to trigger `stop-loss`/`take-profit`/`stop-loss-limit`/`take-profit-limit` orders. `last` is the implied trigger if this field is not set.",
                    "type": "string",
                    "enum": [
                      "last",
                      "index"
                    ],
                    "default": "last"
                  },
                  "margin": {
                    "description": "Indicates if the order is funded on margin.",
                    "type": "boolean"
                  },
                  "misc": {
                    "description": "Comma-delimited list of miscellaneous info: `stopped`, `touched`, `liquidated`, `partial`, `amended`.",
                    "type": "string"
                  },
                  "oflags": {
                    "description": "Comma-delimited list of order flags: `post`, `fcib`, `fciq`, `nompp`, `viqc`.",
                    "type": "string"
                  },
                  "trades": {
                    "description": "List of trade IDs related to the order (if trades info requested and data available).",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "sender_sub_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "For institutional accounts, identifies the underlying sub-account/trader for Self Trade Prevention (STP)."
                  },
                  "closetm": {
                    "description": "Unix timestamp of when the order was closed.",
                    "type": "number"
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Additional info on status (if any)."
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "envelope": {
    "payload": "result"
  },
  "notes": [
    "Upstream's OpenAPI declares `result` itself as `oneOf: [OpenOrder, ClosedOrder]` with no wrapping `additionalProperties` -- doesn't match the documented/example shape, which is a map from txid to one order (oneOf is also disallowed by this format's rule 4 regardless). Modeled here as `result: {additionalProperties: {anyOf: [OpenOrder, ClosedOrder]}}`, matching the worked example and QueryOrders' own `txid`/`ClosedOrder` sibling schemas. The second variant's upstream title (`txid`) was also a copy-paste artifact; retitled `ClosedOrder`."
  ]
}
