{
  "docs": "https://docs.kraken.com/api-reference/market-data/get-order-book",
  "meta": {},
  "spec": {
    "kind": "rpc",
    "transports": [
      "http"
    ],
    "path": "/0/public/Depth",
    "method": "GET",
    "description": "Returns level 2 (L2) order book, which describes the individual price levels in the book with aggregated order quantities at each level.",
    "request": {
      "title": "DepthRequest",
      "type": "object",
      "properties": {
        "pair": {
          "type": "string",
          "description": "Asset pair to get data for."
        },
        "assetVersion": {
          "type": "integer",
          "enum": [
            1
          ],
          "description": "Controls whether response keys use Kraken's internal names or display names. Omitted (default): internal names are used. `assetVersion=1`: display names are used. Only `assetVersion=1` is currently supported."
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100,
          "description": "Maximum number of asks/bids."
        },
        "asset_class": {
          "type": "string",
          "enum": [
            "tokenized_asset"
          ],
          "description": "This parameter is required on requests for non-crypto pairs, i.e. use `tokenized_asset` for xstocks."
        }
      },
      "required": [
        "pair"
      ]
    },
    "response": {
      "title": "DepthFrame",
      "type": "object",
      "description": "Wire frame; the generated method returns `result`.",
      "required": [
        "error",
        "result"
      ],
      "properties": {
        "error": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Wire envelope field; see the core."
        },
        "result": {
          "description": "Pair name (or display name, per `assetVersion`) mapped to its order book.",
          "type": "object",
          "additionalProperties": {
            "title": "OrderBook",
            "description": "One pair's L2 order book.",
            "type": "object",
            "properties": {
              "asks": {
                "description": "Ask side, best first.",
                "type": "array",
                "items": {
                  "title": "DepthLevel",
                  "description": "One price level `[price, volume, timestamp]`.",
                  "type": "array",
                  "prefixItems": [
                    {
                      "title": "price",
                      "type": "string",
                      "description": "Price at this level.",
                      "format": "decimal-string"
                    },
                    {
                      "title": "volume",
                      "type": "string",
                      "description": "Aggregated volume at this level.",
                      "format": "decimal-string"
                    },
                    {
                      "title": "timestamp",
                      "type": "integer",
                      "description": "Unix timestamp this level was last updated."
                    }
                  ],
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "bids": {
                "description": "Bid side, best first.",
                "type": "array",
                "items": {
                  "title": "DepthLevel",
                  "description": "One price level `[price, volume, timestamp]`.",
                  "type": "array",
                  "prefixItems": [
                    {
                      "title": "price",
                      "type": "string",
                      "description": "Price at this level.",
                      "format": "decimal-string"
                    },
                    {
                      "title": "volume",
                      "type": "string",
                      "description": "Aggregated volume at this level.",
                      "format": "decimal-string"
                    },
                    {
                      "title": "timestamp",
                      "type": "integer",
                      "description": "Unix timestamp this level was last updated."
                    }
                  ],
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            }
          }
        }
      }
    }
  },
  "envelope": {
    "payload": "result"
  }
}
