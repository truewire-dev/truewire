{
  "docs": "https://docs.kraken.com/api-reference/market-data/get-ticker-information",
  "meta": {},
  "spec": {
    "kind": "rpc",
    "transports": [
      "http"
    ],
    "path": "/0/public/Ticker",
    "method": "GET",
    "description": "Get ticker information for all or requested markets. Today's prices start at midnight UTC. Leaving the `pair` parameter blank returns tickers for all tradeable assets on Kraken.",
    "request": {
      "title": "TickerRequest",
      "type": "object",
      "properties": {
        "pair": {
          "type": "string",
          "description": "Asset pair to get data for (optional, default: all tradeable exchange pairs)."
        },
        "assetVersion": {
          "type": "integer",
          "enum": [
            1
          ],
          "description": "Controls whether response keys and asset identifier fields use Kraken's internal names or display names. Omitted (default): internal names are used. `assetVersion=1`: display names are used. Only `assetVersion=1` is currently supported."
        },
        "asset_class": {
          "type": "string",
          "enum": [
            "tokenized_asset",
            "forex"
          ],
          "default": "forex",
          "description": "This parameter is required on requests for tokenized pairs, i.e. xstocks. If `asset_class` is provided without the `pair` parameter, all pairs for that asset class will be returned."
        }
      }
    },
    "response": {
      "title": "TickerFrame",
      "type": "object",
      "description": "Wire frame; the generated method returns `result`.",
      "required": [
        "error",
        "result"
      ],
      "properties": {
        "error": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Wire envelope field; see the core."
        },
        "result": {
          "description": "Pair name (or display name, per `assetVersion`) mapped to its ticker snapshot.",
          "type": "object",
          "additionalProperties": {
            "title": "AssetTicker",
            "description": "One pair's ticker snapshot. Field names follow Kraken's own wire shortcuts.",
            "type": "object",
            "properties": {
              "a": {
                "title": "TickerLevel",
                "description": "Ask `[price, whole lot volume, lot volume]`.",
                "type": "array",
                "prefixItems": [
                  {
                    "title": "price",
                    "type": "string",
                    "description": "Ask price."
                  },
                  {
                    "title": "wholeLotVolume",
                    "type": "string",
                    "description": "Whole lot volume at the ask."
                  },
                  {
                    "title": "lotVolume",
                    "type": "string",
                    "description": "Lot volume at the ask."
                  }
                ],
                "minItems": 3,
                "maxItems": 3
              },
              "b": {
                "title": "TickerLevel",
                "description": "Bid `[price, whole lot volume, lot volume]`.",
                "type": "array",
                "prefixItems": [
                  {
                    "title": "price",
                    "type": "string",
                    "description": "Bid price."
                  },
                  {
                    "title": "wholeLotVolume",
                    "type": "string",
                    "description": "Whole lot volume at the bid."
                  },
                  {
                    "title": "lotVolume",
                    "type": "string",
                    "description": "Lot volume at the bid."
                  }
                ],
                "minItems": 3,
                "maxItems": 3
              },
              "c": {
                "title": "TickerLastTrade",
                "description": "Last trade closed `[price, lot volume]`.",
                "type": "array",
                "prefixItems": [
                  {
                    "title": "price",
                    "type": "string",
                    "description": "Last trade closed price."
                  },
                  {
                    "title": "lotVolume",
                    "type": "string",
                    "description": "Last trade closed lot volume."
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "v": {
                "title": "TickerVolume",
                "description": "Volume `[today, last 24 hours]`.",
                "type": "array",
                "prefixItems": [
                  {
                    "title": "today",
                    "type": "string",
                    "description": "Volume traded today."
                  },
                  {
                    "title": "last24Hours",
                    "type": "string",
                    "description": "Volume traded in the last 24 hours."
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "p": {
                "title": "TickerVwap",
                "description": "Volume weighted average price `[today, last 24 hours]`.",
                "type": "array",
                "prefixItems": [
                  {
                    "title": "today",
                    "type": "string",
                    "description": "Volume weighted average price today."
                  },
                  {
                    "title": "last24Hours",
                    "type": "string",
                    "description": "Volume weighted average price in the last 24 hours."
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "t": {
                "title": "TickerTradeCount",
                "description": "Number of trades `[today, last 24 hours]`.",
                "type": "array",
                "prefixItems": [
                  {
                    "title": "today",
                    "type": "integer",
                    "description": "Number of trades today."
                  },
                  {
                    "title": "last24Hours",
                    "type": "integer",
                    "description": "Number of trades in the last 24 hours."
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "l": {
                "title": "TickerLow",
                "description": "Low `[today, last 24 hours]`.",
                "type": "array",
                "prefixItems": [
                  {
                    "title": "today",
                    "type": "string",
                    "description": "Low price today."
                  },
                  {
                    "title": "last24Hours",
                    "type": "string",
                    "description": "Low price in the last 24 hours."
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "h": {
                "title": "TickerHigh",
                "description": "High `[today, last 24 hours]`.",
                "type": "array",
                "prefixItems": [
                  {
                    "title": "today",
                    "type": "string",
                    "description": "High price today."
                  },
                  {
                    "title": "last24Hours",
                    "type": "string",
                    "description": "High price in the last 24 hours."
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "o": {
                "type": "string",
                "description": "Today's opening price."
              }
            }
          }
        }
      }
    }
  },
  "envelope": {
    "payload": "result"
  },
  "notes": [
    "Response schema titled AssetTicker (not OpenAPI's own AssetTickerInfo) to match the existing hand-written pkg/.../market_data.py TypedDict of the same name; every field the OpenAPI declares (a, b, c, v, p, t, l, h, o) is present -- the hand-written TypedDict already matched exactly, so nothing was extended."
  ]
}
