{
  "name": "@truewire/core",
  "version": "0.2.0",
  "description": "Runtime for Truewire-generated TypeScript clients: HTTP, WebSocket and gRPC transport, codecs, paging, timestamps, errors.",
  "keywords": [
    "truewire",
    "api-client",
    "codegen",
    "typescript",
    "http",
    "websocket",
    "codec",
    "validation",
    "pagination",
    "protobuf",
    "grpc"
  ],
  "homepage": "https://truewire.dev",
  "bugs": "https://github.com/truewire-dev/truewire/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/truewire-dev/truewire.git",
    "directory": "packages/core-ts"
  },
  "license": "MIT",
  "author": "Truewire",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./codec": {
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./grpc": {
      "types": "./dist/grpc.d.ts",
      "default": "./dist/grpc.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./paging": {
      "types": "./dist/paging.d.ts",
      "default": "./dist/paging.js"
    },
    "./protobuf": {
      "types": "./dist/protobuf.d.ts",
      "default": "./dist/protobuf.js"
    },
    "./seek": {
      "types": "./dist/seek.d.ts",
      "default": "./dist/seek.js"
    },
    "./times": {
      "types": "./dist/times.d.ts",
      "default": "./dist/times.js"
    },
    "./ws": {
      "types": "./dist/ws/index.d.ts",
      "default": "./dist/ws/index.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "default": "./dist/json.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && npm run test:bundles",
    "prepack": "npm run build",
    "test:bundles": "npm run build && node test/proxyBundle.mjs"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-node": "^2.0.0",
    "protobufjs": "^8.8.0",
    "undici": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@bufbuild/protobuf": {
      "optional": true
    },
    "@connectrpc/connect": {
      "optional": true
    },
    "@connectrpc/connect-node": {
      "optional": true
    },
    "protobufjs": {
      "optional": true
    },
    "undici": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-node": "^2.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "protobufjs": "^8.8.0",
    "typescript": "^5.9.0",
    "undici": "^7.0.0",
    "vitest": "^4.0.0",
    "webpack": "^5.0.0"
  }
}
