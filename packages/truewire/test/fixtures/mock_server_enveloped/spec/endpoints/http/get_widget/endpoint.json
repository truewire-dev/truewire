{
  "function": "widgets.get",
  "spec": {
    "kind": "rpc",
    "transports": [
      "http"
    ],
    "path": "/widgets/{id}",
    "method": "GET",
    "openapi": {
      "description": "Get one widget by id.",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Widget id.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "The widget.",
          "content": {
            "application/json": {
              "schema": {
                "title": "WidgetFrame",
                "type": "object",
                "description": "Wire frame around one widget.",
                "required": [
                  "retCode",
                  "result"
                ],
                "properties": {
                  "retCode": {
                    "type": "integer",
                    "description": "Wire envelope field; see the core."
                  },
                  "retMsg": {
                    "type": "string",
                    "description": "Wire envelope field; see the core."
                  },
                  "result": {
                    "title": "Widget",
                    "type": "object",
                    "description": "One widget.",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Widget name."
                      },
                      "stock": {
                        "type": "integer",
                        "description": "Units in stock."
                      }
                    },
                    "required": [
                      "name",
                      "stock"
                    ]
                  },
                  "retExtInfo": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Wire envelope field; see the core."
                  },
                  "time": {
                    "type": "integer",
                    "description": "Wire envelope field; see the core."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "envelope": {
    "payload": "result",
    "correlate": "id"
  }
}
