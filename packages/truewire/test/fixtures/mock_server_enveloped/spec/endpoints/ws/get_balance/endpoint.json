{
  "function": "acme.ws_get_balance",
  "spec": {
    "kind": "rpc",
    "transports": [
      "ws"
    ],
    "path": "acme_getBalance",
    "openapi": {
      "description": "Returns the balance of one address over WS.",
      "requestBody": {
        "required": true,
        "description": "Positional JSON-RPC parameter: address.",
        "content": {
          "application/json": {
            "schema": {
              "title": "WsGetBalanceParams",
              "type": "string",
              "description": "Address to check the balance of."
            }
          }
        }
      },
      "responses": {
        "reply": {
          "description": "The balance.",
          "content": {
            "application/json": {
              "schema": {
                "title": "WsGetBalanceFrame",
                "type": "object",
                "description": "JSON-RPC reply frame.",
                "required": [
                  "jsonrpc",
                  "id",
                  "result"
                ],
                "properties": {
                  "jsonrpc": {
                    "type": "string",
                    "enum": [
                      "2.0"
                    ],
                    "description": "Wire envelope field; see the core."
                  },
                  "id": {
                    "type": "integer",
                    "description": "Wire envelope field; see the core."
                  },
                  "result": {
                    "type": "string",
                    "description": "Hex-encoded balance."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "envelope": {
    "payload": "result",
    "correlate": "id"
  }
}
