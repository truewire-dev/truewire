  ],
  "spec": {
    "kind": "stream",
    "channel": "sub.depth",
    "openapi": {
      "description": "Synthetic depth stream subscribed to with a venue-shaped JSON frame.",
      "parameters": [
        {
          "name": "symbol",
          "in": "path",
          "required": true,
          "description": "Contract symbol.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "reply": {
          "description": "Subscription acknowledgement."
        },
        "message": {
          "description": "Depth update."
        }
      }
    }
  }
}
